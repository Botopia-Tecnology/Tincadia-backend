# Chat Microservice Configuration
chatPort="3006"

# Supabase Configuration
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_KEY="your-service-role-key-here"

# --- Corrección de texto con IA (chat y pizarra) ---
# Funciona con cualquier proveedor compatible con la API de OpenAI.
# Por defecto usa NVIDIA NIM; para cambiar de proveedor sólo cambian estas
# variables, sin tocar código.
AI_BASE_URL="https://integrate.api.nvidia.com/v1"
AI_API_KEY="nvapi-your-nvidia-key-here"
AI_MODEL="minimaxai/minimax-m3"

# Opcionales (con valores por defecto razonables):
# AI_TEMPERATURE="0.3"
# AI_MAX_TOKENS="1024"
# AI_TIMEOUT_MS="20000"

# Ejemplo para usar Gemini en su lugar (endpoint compatible con OpenAI):
# AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
# AI_API_KEY="your-gemini-api-key-here"
# AI_MODEL="gemini-2.5-flash-lite"


ENCRYPTION_KEY="your-character-key-here"
