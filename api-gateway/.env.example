# API Gateway Configuration
PORT="3001"

# JWT Configuration (for validating tokens)
JWT_SECRET="your-jwt-secret-key-here"

# Microservices TCP Configuration
authHost="localhost"
authPort="3002"
paymentsHost="localhost"
paymentsPort="3003"
formsHost="localhost"
formsPort="3004"
communicationHost="localhost"
communicationPort="3005"


# CORS Configuration
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# Chat Service
chatHost="localhost"
chatPort="3006"

# --- Corrección de texto con IA (streaming SSE) ---
# Debe apuntar al mismo proveedor/modelo configurado en chat-ms, para que el
# streaming y el no-streaming den resultados consistentes.
AI_BASE_URL="https://integrate.api.nvidia.com/v1"
AI_API_KEY="nvapi-your-nvidia-key-here"
AI_MODEL="minimaxai/minimax-m3"

# Opcionales:
# AI_TEMPERATURE="0.3"
# AI_MAX_TOKENS="1024"
# AI_TIMEOUT_MS="20000"
ENABLE_DEBUG_LOGS=false
